# Автоматически определять текстовые файлы
* text=auto

# C#/MSBuild/Windows-файлы — CRLF в рабочей директории
*.cs        text eol=crlf
*.csproj    text eol=crlf
*.sln       text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.resx      text eol=crlf
*.config    text eol=crlf

# Документация и конфиги — LF (для кроссплатформенности)
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
workflow.md text eol=lf
docs/**     text eol=lf

# Бинарные файлы — не трогать
*.png       binary
*.jpg       binary
*.dll       binary
*.exe       binary

# Логи — CRLF (их пишет 7DTD на Windows)
*.log       text eol=crlf